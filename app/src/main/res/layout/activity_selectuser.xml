<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/selectUserLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF"
    tools:context=".SelectUserActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/tvSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Who are you?"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp" />

    <!-- Teacher Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTeacher"
        android:layout_width="390dp"
        android:layout_height="150dp"
        android:layout_below="@id/tvSelect"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/teacher"
            android:scaleType="centerCrop"
            android:contentDescription="Teacher" />
    </androidx.cardview.widget.CardView>

    <!-- Student Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStudent"
        android:layout_width="390dp"
        android:layout_height="150dp"
        android:layout_below="@id/cardTeacher"
        android:layout_marginTop="30dp"
        android:layout_centerHorizontal="true"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/student"
            android:scaleType="centerCrop"
            android:contentDescription="Student" />
    </androidx.cardview.widget.CardView>

    <!-- Admin Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAdmin"
        android:layout_width="390dp"
        android:layout_height="150dp"
        android:layout_below="@id/cardStudent"
        android:layout_marginTop="36dp"
        android:layout_centerHorizontal="true"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/admin"
            android:scaleType="centerCrop"
            android:contentDescription="Admin" />
    </androidx.cardview.widget.CardView>

</RelativeLayout>
