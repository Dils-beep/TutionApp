<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/studentLoginLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFFFFF"
    tools:context=".StudentLoginActivity">

    <!-- Page Title -->
    <TextView
        android:id="@+id/tvStudentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Login"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#DC704A"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/montserrat_black"
        android:shadowColor="#66000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Login Image -->
    <ImageView
        android:id="@+id/imgStudentLogin"
        android:layout_width="334dp"
        android:layout_height="317dp"
        android:layout_below="@id/tvStudentTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:contentDescription="Student Login Image"
        android:src="@drawable/loginstudent" />

    <!-- Username Field -->
    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Username"
        android:layout_below="@id/imgStudentLogin"
        android:layout_marginTop="40dp"
        android:padding="12dp"
        android:background="@drawable/edittext_background"
        android:inputType="textPersonName"
        android:drawableStart="@android:drawable/ic_menu_myplaces" />

    <!-- Password Field -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:layout_below="@id/etUsername"
        android:layout_marginTop="20dp"
        android:padding="12dp"
        android:background="@drawable/edittext_background"
        android:inputType="textPassword"
        android:drawableStart="@android:drawable/ic_lock_lock" />

    <!-- Login Button -->
    <Button
        android:id="@+id/btnStudentLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/etPassword"
        android:layout_marginTop="30dp"
        android:backgroundTint="#6c8887"
        android:elevation="4dp"
        android:padding="12dp"
        android:text="Login"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</RelativeLayout>
